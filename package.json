{
  "name": "contract-trail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose --env-file .env -f infra/data-compose.yml up -d",
    "ask": "tsx src/cli/ask.ts",
    "memory:reset": "tsx scripts/memory-reset.ts",
    "probe:models": "tsx scripts/probe-models.ts",
    "ingest": "tsx scripts/ingest/index.ts",
    "zetaris:register": "tsx scripts/zetaris/register.ts",
    "check:zetaris": "tsx scripts/zetaris/check.ts",
    "check:nightshift": "tsx scripts/zetaris/check-nightshift.ts",
    "check:cpi": "tsx scripts/zetaris/check-cpi.ts",
    "conformance:hmem": "HMEM_IMPL=$PWD/src/engines/hmem/index.ts npx tsx vendor/meterless/engines/hmem/conformance/runner.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
