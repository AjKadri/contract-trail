# Copy to .env and fill in. Never commit .env.
# Zetaris (local Docker install)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key
# Meterless Nightshift (Console > This computer)
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-key
METERLESS_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
METERLESS_DEEP_MODEL=nvidia/nemotron-3-ultra-550b-a55b
METERLESS_EMBED_MODEL=nvidia/nemotron-3-embed-1b
# Data Postgres (ct-pg container). Ingestion only; the app reads through Zetaris.
CT_PG_PASSWORD=change-me
# Replay a recorded run with no services
SAMPLE_MODE=false
